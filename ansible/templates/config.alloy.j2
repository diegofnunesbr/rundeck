prometheus.scrape "node" {
  targets = [{"__address__" = "localhost:9100", "instance" = "{{ ansible_hostname }}"}]
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "{{ mimir_remote_write_url }}"

    basic_auth {
      username      = "alloy"
      password_file = "/etc/alloy/push-password"
    }
  }

  external_labels = {
    host = "{{ inventory_hostname }}",
    env  = "homelab",
  }
}
